# Copy to deploy.env (gitignored) and fill in. Read by ./deploy.sh.
EC2_HOST=
EC2_USER=ec2-user            # ubuntu on Ubuntu AMIs
SSH_KEY=~/.ssh/your-key.pem  # leave empty to use ssh-agent / default keys
# EC2_PORT=22
# REMOTE_DIR=/opt/arena      # where .env and wallets.json live on the server
# HOST_PORT=8080
# BIND_ADDR=0.0.0.0          # 127.0.0.1 = only via reverse proxy / ssh tunnel (recommended with real money)
# PLATFORM=                  # linux/amd64 | linux/arm64 ; empty = detect (Graviton = arm64)
# HEALTH_TIMEOUT=120

# Copy to .env (the binary loads ./.env itself; real env vars win over it).
# Run `./bin/arena doctor` after editing: it checks everything read-only.

# --- Definitive Flash ---------------------------------------------------------
# Your own integrator key (dpka_...). Never commit the real value.
FLASH_API_KEY=dpka_replace_me
FLASH_BASE_URL=https://flash.definitive.fi/v1
# Integrator fee in basis points, sent on BOTH quote and order (10 = 0.10%, 0 = no fee).
FLASH_FEE_BPS=10
# Contracts we sign for. The settlement contract is published in Flash's
# security docs (same address on every EVM chain). The vault is per integrator
# account: the first one seen is pinned and logged; copy it here.
FLASH_SETTLEMENT_ALLOWLIST=0x5d00000873b6BF41539e6f5365B0Ff7d3c368f78
FLASH_VAULT_ALLOWLIST=
# Optional builder code (erc8021AttributionCode, 1-32 chars of [a-zA-Z0-9_.-]).
FLASH_ATTRIBUTION_CODE=
# Order updates over wss://flash.definitive.fi/v1/ws (REST polling stays on as a fallback).
FLASH_STREAM=true

# --- Chain (Base mainnet: Flash has no testnet) --------------------------------
CHAIN=base
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
WETH_ADDRESS=0x4200000000000000000000000000000000000006
TRADE_SYMBOL=WETH
# Reference price: Uniswap v3 WETH/USDC 0.05% pool on Base, read onchain and
# verified at startup. Flash quotes are checked against it. Empty = Flash /search
# (some keys get 403 SEARCH_NOT_ELIGIBLE until they have Flash volume).
PRICE_POOL=0xd0b53D9277642d899DF5C87A3966A349A798F224

# --- Wallets (Level 1 sub-wallets) ----------------------------------------------
WALLETS_FILE=./wallets.json

# --- Mode -------------------------------------------------------------------------
# paper = mock money: real Flash quotes, real signing (verified), simulated fills
#         and exits at the real onchain price. Data goes to DATA_DIR/paper.
# dry   = quote + sign, never submit (same as DRY_RUN=true).
# live  = real orders with real money. Read the three guards below first.
# Empty = DRY_RUN decides (true -> dry, false -> live).
MODE=
DRY_RUN=true
# Paper mode: mock USDC each wallet starts with ($100 keeps agent trades near $20,
# where Flash's fixed cost is small). The $10 caps below only protect
# real money, so paper mode lifts them: trades up to PAPER_MAX_TRADE_USD and
# human approval only for copies above PAPER_APPROVAL_THRESHOLD_USD.
PAPER_USDC=100
PAPER_MAX_TRADE_USD=100
PAPER_APPROVAL_THRESHOLD_USD=50
# Coins personal auto-trade plans can pick besides WETH (SYMBOL:ADDRESS:DECIMALS,
# decimals re-checked onchain at startup; priced by Flash quotes). Empty = WETH only.
EXTRA_TOKENS=cbBTC:0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf:8
# Live mode guard 1: agents do NOT trade real money on their own unless this is
# true. Until then only operator test trades (and manual proposals) go out.
LIVE_AGENTS=false
# Live mode guard 2: total USDC that may ever go into live entries (all wallets).
LIVE_BUDGET_USD=5
# Live mode guard 3: the operator test trade (Operator page / `arena smoke -test`).
# Small orders cost more in % (a $1 Flash quote was ~1.2% all-in on Nov 6, 2026),
# so tests get their own cost cap and keep their take profit close.
TEST_TRADE_USD=1
TEST_MAX_COST_PCT=12
TEST_TP_PCT=2
TEST_SL_PCT=2

# --- Safety -----------------------------------------------------------------------
MAX_TRADE_USD=5
MAX_POSITION_PCT=25
# Small wallets: Flash's cost per order is mostly fixed (~$0.05 on Nov 6, 2026), so a
# 20% slice of a $9 wallet ($1.80) costs ~3% and the cost guard refuses it. With a
# minimum, agents trade at least this much (wallet allowing; MAX_POSITION_PCT still
# applies, so raise it too, e.g. MIN_TRADE_USD=4 and MAX_POSITION_PCT=55). 0 = off.
# See real costs per size with `arena costs`.
MIN_TRADE_USD=0

# --- Gasless (people hold only USDC) ------------------------------------------------
# `arena gastank` adds a gas tank key to wallets.json; fund it with ~$1 of ETH on Base.
# It tops up arena wallets that must send their own tx (approvals, withdrawals) and
# sends people's signed USDC deposits (EIP-3009). Flash already pays order gas.
GAS_DRIP_ETH=0.00002
GAS_TANK_DAILY_ETH=0.0005
GAS_DRIPS_PER_WALLET_DAY=5
DEPOSIT_MAX_USD=100
MAX_TRADES_PER_DAY=5
# Onchain lock: ERC-20 allowance cap per wallet (USDC units ~ USD). Must be >= MAX_TRADE_USD.
MAX_APPROVAL_USD=10
# Copy trades above this need a human approval (World Agent Pass / admin)
APPROVAL_THRESHOLD_USD=10
APPROVAL_TIMEOUT=2m
# Refuse quotes where Flash's WETH valuation is this far from the onchain price
MAX_PRICE_DEVIATION_PCT=1.5
# Refuse tokens with less USD liquidity than this (exit must be possible)
MIN_LIQUIDITY_USD=1000000
# Circuit breaker: pause an agent and its copiers past this drawdown from peak
MAX_AGENT_DRAWDOWN_PCT=20
# Risk layer for automated entries (agents, copies, investors, plans):
# no new entries when the price range over MOVE_CHECKS price checks is wider than MAX_MOVE_PCT
MAX_MOVE_PCT=3
MOVE_CHECKS=60
# after MAX_LOSS_STREAK losses in a row a wallet waits LOSS_STREAK_PAUSE
MAX_LOSS_STREAK=3
LOSS_STREAK_PAUSE=1h
# live: realized losses today that turn on the emergency stop (0 = off)
DAILY_LOSS_LIMIT_USD=0
# close an automated position at market after this many hours (0 = off; agents can set their own)
MAX_HOLD_HOURS=0
# Execution cost. Every Flash quote costs about $0.06 + 0.36% all-in
# ($2 -> 3.5%, $5 -> 1.4%, $20 -> 0.7%, $100 -> 0.4%).
# maxSlippage sent on quote + order (Flash suggests up to 15% for tiny orders if omitted).
MAX_SLIPPAGE=0.03
# Refuse entries whose all-in cost is above this % of the trade.
MAX_ENTRY_COST_PCT=2.5
# Raise each take profit by the estimated round-trip cost, so a "win" is a real win.
NET_TARGETS=true
# Move the stop to break-even (Flash order update) once price is halfway to the target.
BREAKEVEN_STOP=true

# --- Loops ------------------------------------------------------------------------
PRICE_EVERY=15s
AGENT_EVERY=30s
EQUITY_EVERY=60s
ORDER_POLL=5s
COPY_WORKERS=4

# --- HTTP -------------------------------------------------------------------------
# 127.0.0.1:8080 keeps it local (a tunnel or reverse proxy publishes it).
HTTP_ADDR=127.0.0.1:8080
# 32+ random chars: openssl rand -hex 24
ADMIN_TOKEN=replace_with_long_random_token
CORS_ORIGINS=

# --- Storage / Arkiv ----------------------------------------------------------------
DATA_DIR=./data
SEASON_ID=mumbai-s1
# arkiv-sync sidecar (optional). Leave ARKIV_SYNC_URL empty to keep events locally only.
ARKIV_SYNC_URL=
ARKIV_SYNC_TOKEN=replace_with_shared_secret
# Read by arkiv-sync only (cd arkiv-sync && npm start). Free at https://hub.arkiv.network
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
LOG_LEVEL=info

# --- Social (optional) -------------------------------------------------------------
# Public address of this app (e.g. your tunnel URL), used in bot posts and share links.
PUBLIC_URL=
# Signal bot: the agents' trades and results posted to a Discord channel webhook
# and/or a Telegram chat (create a bot with @BotFather, add it to the chat).
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

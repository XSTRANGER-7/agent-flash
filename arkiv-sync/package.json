{
  "name": "arkiv-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Publishes Agent Arena public records (agents, trades, results, predictions) to Arkiv",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "dev": "tsx --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.10"
  }
}
